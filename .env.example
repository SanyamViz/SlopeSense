# Copy this file to .env and fill in the real values.
# NEVER commit .env -- it is already in .gitignore.

# OpenTopography SRTM API key (only needed to download real DEM data via
# prepare_real_data.py). Get a free key at https://opentopography.org/developers
OPENTOPO_API_KEY=

# Public URL of the deployed frontend, used for CORS allow-list if you ever
# tighten CORS. Currently the backend allows all origins ("*") for the demo.
FRONTEND_URL=

# --- Twilio SMS/WhatsApp alert dispatch (POST /dispatch) ---
# Get a free account + sandbox at https://www.twilio.com/try-twilio
# Find your Account SID and Auth Token at https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sandbox "from" number (include the whatsapp: prefix, e.g.
# whatsapp:+14155238886). Get the sandbox number from the Twilio Console
# WhatsApp sandbox section.
TWILIO_WHATSAPP_FROM=
# Twilio trial phone number in E.164 format (e.g. +17372212163) used as the
# "from" address for regular SMS dispatches. This number must also be
# voice-capable if you want voice-call escalation (Task 1) to work; the voice
# call escalation reuses this number as its caller-ID.
TWILIO_SMS_FROM=

# Comma-separated list of recipient numbers in E.164 format (e.g.
# +9198xxxxxxx,+9199xxxxxxx). One failed number does not fail the whole
# broadcast -- each recipient is attempted individually. The same recipients
# are used for voice-call escalation when a severe+elderly zone is encountered.
# DISPATCH_RECIPIENTS=

# --- Voice-call escalation (POST /dispatch) ---
# Only zones with risk_level == "severe" AND elderly_pct above this threshold
# trigger a Twilio Voice call in addition to the SMS/WhatsApp broadcast.
# Set to 0 to disable voice-call escalation entirely.
VOICE_CALL_ELDERLY_THRESHOLD_PCT=25